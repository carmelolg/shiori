{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
  {{- $pages = $pages | append (dict
    "title"     .Title
    "permalink" .RelPermalink
    "summary"   (.Params.summary | default "")
    "section"   (.Section | humanize)
    "content"   (.Plain | truncate 400)
    "tags"      (.Params.tags | default slice)
    "method"    (.Params.method | default "")
    "endpoint"  (.Params.endpoint | default "")
  ) -}}
{{- end -}}
{{ $pages | jsonify }}
